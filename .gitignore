build/
cmake-build*/
out/
x64/

scratch/

.vs/
.git/

# CMake artefacts that may land in the source tree
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json
ctest_*.log
Testing/

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
*.swo

# IDE-local per-user project state (must never be version-controlled)
*.vcxproj.user

# Test artefacts the integration test drops in cwd
test_results.txt
java_stdout.txt
java_stderr.txt

# Ignore local Claude Code settings, but DO track the committed specialized
# feature agents — one subagent per vmhook feature, each mastering its feature
# and owning its exhaustive JVM test module.
.claude/*
!.claude/agents/

# Obsidian: only the curated vault-root audit/graph/.obsidian/ is tracked (emitted by
# generate.py). Ignore stray per-user state + accidentally-opened-subfolder vaults.
audit/graph/**/workspace.json
audit/graph/categories/.obsidian/
audit/graph/categories/features/

# Local CI closed environment: track the harness script (+ README), ignore the
# heavy machine-specific dirs — downloaded JDKs, per-compiler builds, scratch, logs.
.localci/jdks/
.localci/cache/
.localci/builds/
.localci/work/
.localci/logs/

# Foreign droppings from side-loaded MCP tooling that writes to CWD (e.g. the
# Cheat-Engine MCP server's process whitelist) — not part of vmhook.
process_whitelist.json

# vmhook viewer: vendored ImGui (cloned, not tracked)
viewer/third_party/imgui/

# viewer e2e test artifacts
viewer/test/*.class
viewer/test/sleeper.log

viewer/example/out/
viewer/example/app.log

# Working notes and local UI state — not part of the shipped library.
docs/
_surface.txt
imgui.ini

# Developer-only, deliberately not published with the library: the test suite
# and JVM harness, the GitHub workflows, and the local CI runner.  CMakeLists
# skips the test/example targets when these are absent, so a clone still builds.
.github/
.localci/
tests/

# Developer-only, not part of what a consumer clones: the Java fixtures the JVM
# harness compiles, the injector, the example/speedtest TUs, and the MSBuild
# project files that predate the CMake build.
example/
injector/
vmhook/src/
vmhook.slnx
*.vcxproj
*.vcxproj.filters
*.vcxproj.user

# One-shot migration scripts (the g++-only collapse and the de-macro passes).
# They ran once; what they produced is the library, which is what belongs here.
tools/

# Python leaves these next to anything it imports.
__pycache__/
*.pyc
