+        /*
+            @brief One (type-name, field-name) candidate for a VMStruct lookup.
+            @details
+            The narrow-OOP and narrow-Klass base/shift fields live under different
+            (type, field) names depending on the JDK version, so every compressed-pointer
+            codec must try several names in order and take the first that resolves.  This
+            POD captures one such attempt; resolve_struct_entry() walks an ordered array
+            of them.  Kept as a plain aggregate (no <utility>/<initializer_list> needed)
+            so the candidate arrays remain constexpr-friendly and header-only.
+        */
+        struct struct_entry_candidate_t
+        {
+            const char* type_name;
+            const char* field_name;
+        };
+
+        /*
+            @brief Resolves the first matching gHotSpotVMStructs entry from an ordered
+                   list of (type-name, field-name) candidates.
+            @param candidates  Pointer to the first candidate to try.
+            @param count       Number of candidates.
+            @return The first entry that iterate_struct_entries() resolves, in array
+                    order, or nullptr if none of the candidates resolve.
+            @details
+            Behaviour-preserving extraction of the per-codec resolver lambda that the
+            four compressed-pointer codecs previously embedded verbatim: it tries each
+            candidate in turn and returns on the first hit, exactly as the original
+            hand-unrolled "try A, else try B, else return C" chains did.  Performs no
+            caching itself — callers cache the result in a function-local
+            `static const ... = resolve_struct_entry(...)`, which preserves the original
+            once-per-call-site resolution semantics (the static initializer runs the
+            lookup exactly once on the first call and reuses it thereafter).
+        */
+        static auto resolve_struct_entry(const vmhook::hotspot::struct_entry_candidate_t* const candidates,
+                                         const std::size_t count) noexcept
+            -> const vmhook::hotspot::vm_struct_entry_t*
+        {
+            for (std::size_t index{ 0 }; index < count; ++index)
+            {
+                const vmhook::hotspot::vm_struct_entry_t* const entry{
+                    vmhook::hotspot::iterate_struct_entries(candidates[index].type_name, candidates[index].field_name) };
+                if (entry)
+                {
+                    return entry;
+                }
+            }
+            return nullptr;
+        }
+
+        /*
+            @brief Decodes a compressed pointer using a resolved base/shift pair.
+            @param base        narrow base address (read from the VMStruct base field).
+            @param shift       narrow shift amount (read from the VMStruct shift field).
+            @param compressed  The non-zero 32-bit compressed value.
+            @return real_address = base + (compressed << shift).
+            @details
+            Shared arithmetic primitive for decode_oop_pointer()/decode_klass_pointer(),
+            whose decode formulas were already bitwise-identical.  The caller is
+            responsible for the compressed==0 -> nullptr short-circuit and the
+            missing-entry handling; this performs only the unsigned widening shift-add.
+        */
+        static auto narrow_decode(const std::uint64_t base, const std::uint32_t shift,
+                                  const std::uint32_t compressed) noexcept
+            -> void*
+        {
+            return reinterpret_cast<void*>(base + (static_cast<std::uint64_t>(compressed) << shift));
+        }
+
+        /*
+            @brief Encodes a full address into a compressed pointer using a resolved
+                   base/shift pair.
+            @param base   narrow base address (read from the VMStruct base field).
+            @param shift  narrow shift amount (read from the VMStruct shift field).
+            @param addr   The full 64-bit address, already known to be >= base.
+            @return compressed = (addr - base) >> shift.
+            @details
+            Shared arithmetic primitive for encode_oop_pointer()/encode_klass_pointer(),
+            whose encode formulas were already bitwise-identical.  The caller is
+            responsible for the decoded==nullptr -> 0 short-circuit, the missing-entry
+            handling, and the addr<base -> 0 underflow guard; this performs only the
+            subtract-shift-narrow.
+        */
+        static auto narrow_encode(const std::uint64_t base, const std::uint32_t shift,
+                                  const std::uint64_t addr) noexcept
+            -> std::uint32_t
+        {
+            return static_cast<std::uint32_t>((addr - base) >> shift);
+        }
